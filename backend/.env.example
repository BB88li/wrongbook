# 复制为 .env 后填写真实值；.env 已被 .gitignore 排除
# 数据库：默认 SQLite（零配置）；切 MySQL 时取消注释并填密码
# DATABASE_URL=mysql+pymysql://root:你的密码@localhost:3306/wrongbook?charset=utf8mb4

# AI API 密钥（题目识别 / 讲解出题），接入时再填
AI_MULTIMODAL_API_KEY=
AI_TEXT_API_KEY=

# 允许跨域的来源，逗号分隔；* 仅用于开发与答辩演示
# 正式部署时改成前端实际域名，例如 https://wrongbook.example.com
CORS_ORIGINS=*
